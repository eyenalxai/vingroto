{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "vingroto",
  "version": "0.9.2",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "start": "cd packages/client && bun run start",
    "server": "cd packages/server && bun run start",
    "build": "bun run --filter @vingroto/client build && bun run --filter @vingroto/server build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "tsc": "bun run --filter '*' tsc",
    "check": "bun run format:check && bun run lint && bun run tsc",
    "db:generate": "bun run --filter @vingroto/server db:generate",
    "db:check": "bun run --filter @vingroto/server db:check"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  }
}
