[Unit]
Description=vingroto development mail daemon
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/env bun run server
WorkingDirectory=%h/Projects/js/vingroto
Environment=PATH=%h/.local/share/mise/shims:/usr/local/bin:/usr/bin
Environment=VINGROTO_PROFILE=development
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
